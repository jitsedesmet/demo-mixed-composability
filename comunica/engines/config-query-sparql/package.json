{
  "name": "@local/config-query-sparql",
  "version": "5.0.0",
  "private": "true",
  "description": "default configuration files for Comunica SPARQL local",
  "lsd:module": true,
  "license": "MIT",
  "keywords": [
    "comunica",
    "sparql",
    "engine",
    "query",
    "update",
    "config",
    "hdt"
  ],
  "sideEffects": false,
  "main": "lib/index.js",
  "typings": "lib/index",
  "files": [
    "components",
    "config",
    "lib/**/*.d.ts",
    "lib/**/*.js",
    "lib/**/*.js.map"
  ],
  "scripts": {
    "build": "npm run build:ts && npm run build:components",
    "build:ts": "node \"../../node_modules/typescript/bin/tsc\"",
    "build:components": "componentsjs-generator"
  },
  "dependencies": {
    "@comunica/config-query-sparql": "~5.0.0",
    "@local/actor-function-factory-term-adjust": "link:../../packages/actor-function-factory-term-adjust",
    "@local/actor-query-operation-lateral": "link:../../packages/actor-query-operation-lateral",
    "@local/actor-query-parse-sparql": "link:../../packages/actor-query-parse-sparql",
    "@local/bus-function-factory": "link:../../packages/bus-function-factory"
  }
}
